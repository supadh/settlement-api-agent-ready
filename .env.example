# Feature flags accept: 1, true, yes, on, 0, false, no, off.
FEATURE_STRICT_SETTLEMENT_VALIDATION=false

# Observability integrations are disabled when their credentials are empty.
APP_ENVIRONMENT=development
APP_RELEASE=local
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
GRAFANA_DASHBOARD_URL=

# Secrets may be injected directly or via a mounted *_FILE, never both.
SENTRY_DSN_FILE=
POSTHOG_API_KEY_FILE=
ADMIN_API_KEY=
ADMIN_API_KEY_FILE=

# In-memory records older than this are purged on each request.
DATA_RETENTION_DAYS=30
